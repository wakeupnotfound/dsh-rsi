{
  "$schema": "https://raw.githubusercontent.com/T-Auto/dsh-std/8a15541117cb3c13ddb8f2468308691b6051d162/packages/manifest/schema/dsh-plugin-0.15.schema.json",
  "manifestVersion": "0.15",
  "id": "dsh-rsi",
  "name": "dsh-rsi",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "facets": {
    "host": {
      "entry": "lib/index.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "tools.dsh/v1alpha1",
        "kind": "Tool"
      }
    ]
  },
  "permissions": [
    {
      "name": "dsh-rsi.fs.storage",
      "scope": "dsh-home",
      "reason": "Read and write durable memory records and audit logs under ~/.dsh/storages/rsi"
    },
    {
      "name": "dsh-rsi.subprocess.probe",
      "scope": "subprocess",
      "reason": "Execute independent read-only inspection probes for Verifier candidate acceptance"
    },
    {
      "name": "dsh-rsi.workflow.orchestrate",
      "scope": "subprocess",
      "reason": "Start RSI exploration and practice workflows through the DSH workflow engine on behalf of the calling agent"
    }
  ],
  "contributes": {
    "x-display": [
      {
        "icon": "./icon.png",
        "title": "dsh-rsi",
        "description": "基于 RSIAgent 递归自我改进引擎：独立双盲验证、因果经验提炼与跨会话可演化记忆",
        "locales": [
          "locale/en.json",
          "locale/zh.json"
        ]
      }
    ],
    "x-prompt-sections": [
      {
        "name": "dsh-rsi:epistemic-core",
        "order": 3100,
        "summary": "Truth channel axioms (E1-E6) to ground claims in verifiable evidence and prevent hallucination"
      },
      {
        "name": "dsh-rsi:memory-inventory",
        "order": 3110,
        "summary": "Dynamic durable memory inventory from ~/.dsh/storages/rsi with causal guidelines"
      }
    ],
    "x-tool-namespaces": [
      {
        "serverName": "dsh-rsi",
        "transport": "in-process",
        "source": "native RSI engine",
        "publicPrefix": "rsi_",
        "tools": [
          "verify",
          "distill_memory",
          "reconcile_memory",
          "query_memory",
          "explore",
          "practice"
        ]
      }
    ],
    "x-components": [
      {
        "id": "dsh-rsi-verifier",
        "entry": "dsh-rsi/verifier",
        "defaultEnabled": true,
        "platforms": ["win32", "linux", "darwin"],
        "targets": ["win32-x64", "linux-x64", "darwin-arm64"]
      },
      {
        "id": "dsh-rsi-memory",
        "entry": "dsh-rsi/memory",
        "defaultEnabled": true,
        "platforms": ["win32", "linux", "darwin"],
        "targets": ["win32-x64", "linux-x64", "darwin-arm64"]
      },
      {
        "id": "dsh-rsi-epistemic",
        "entry": "dsh-rsi/epistemic",
        "defaultEnabled": true,
        "platforms": ["win32", "linux", "darwin"],
        "targets": ["win32-x64", "linux-x64", "darwin-arm64"]
      },
      {
        "id": "dsh-rsi-explorer",
        "entry": "dsh-rsi/explorer",
        "defaultEnabled": true,
        "platforms": ["win32", "linux", "darwin"],
        "targets": ["win32-x64", "linux-x64", "darwin-arm64"]
      }
    ]
  }
}
